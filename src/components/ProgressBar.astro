---
import type { Progress } from "../libs/tracker";

interface Props {
  progress: Progress;
}

const { progress } = Astro.props;

const percentage =
  progress.total === 0
    ? 100
    : Math.floor((progress.done / progress.total) * 100);
---

<div class="progress">
  <div class="progress-track" aria-hidden="true">
    <div
      class:list={["progress-fill", { complete: progress.missing === 0 }]}
      style={{ width: `${percentage}%` }}
    ></div>
  </div>
  <span class="progress-label">
    {percentage}%<span class="sr-only"> translated</span>
  </span>
</div>

<style>
  .progress {
    align-items: center;
    display: flex;
    gap: 0.75rem;
  }

  .progress-track {
    background: var(--color-track);
    border-radius: 999px;
    flex: 1;
    height: 0.5rem;
    overflow: hidden;
  }

  .progress-fill {
    background: var(--color-accent);
    border-radius: inherit;
    height: 100%;
  }

  .progress-fill.complete {
    background: var(--color-done);
  }

  .progress-label {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    min-width: 2.75rem;
    text-align: end;
  }
</style>
