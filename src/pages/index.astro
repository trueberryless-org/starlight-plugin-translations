---
import { formatCount } from "../libs/format";
import {
  getLanguageProgress,
  getPluginProgress,
  getTrackedLanguages,
  getTrackedPlugins,
} from "../libs/tracker";

import OverviewCard from "../components/OverviewCard.astro";
import Section from "../components/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const plugins = await getTrackedPlugins();
const languages = getTrackedLanguages(plugins);
---

<BaseLayout>
  <header class="hero">
    <p class="hero-eyebrow">Starlight ecosystem</p>
    <h1>Starlight Plugin Translations</h1>
    <p class="hero-lead">
      The current state of UI translations in
      {formatCount(plugins.length, "Starlight plugin", "Starlight plugins")}
      across {formatCount(languages.length, "language", "languages")}.
    </p>
  </header>

  <Section id="plugins" title="Plugins">
    <ul>
      {plugins.map((plugin) => (
        <OverviewCard
          description={`${formatCount(plugin.keys.length, "key", "keys")} · ${formatCount(plugin.locales.length, "language", "languages")}`}
          href={`/plugins/${plugin.config.packageName}/`}
          progress={getPluginProgress(plugin)}
          subtitle={plugin.config.packageName}
          title={plugin.config.name}
        />
      ))}
    </ul>
  </Section>

  <Section id="languages" title="Languages">
    <ul>
      {languages.map((language) => (
        <OverviewCard
          description={`${language.lang} · ${formatCount(language.plugins.length, "plugin", "plugins")}`}
          href={`/languages/${language.lang}/`}
          progress={getLanguageProgress(language)}
          subtitle={
            language.englishName === language.nativeName
              ? undefined
              : language.englishName
          }
          title={language.nativeName}
        />
      ))}
    </ul>
  </Section>
</BaseLayout>

<style>
  .hero {
    max-width: 48rem;
  }

  .hero-eyebrow {
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    margin-block-end: 0.75rem;
    text-transform: uppercase;
  }

  .hero-lead {
    color: var(--color-text-muted);
    font-size: 1.1875rem;
    margin-block-start: 1rem;
  }
</style>
