---
import { formatCount } from "../libs/format";
import {
  getLanguageProgress,
  getPluginProgress,
  getTrackedLanguages,
  getTrackedPlugins,
} from "../libs/tracker";

import OverviewCard from "../components/OverviewCard.astro";
import Section from "../components/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const plugins = await getTrackedPlugins();
const languages = getTrackedLanguages(plugins);
---

<BaseLayout>
  <header class="hero">
    <p class="hero-eyebrow">Starlight ecosystem</p>
    <h1>Starlight Plugin Translations</h1>
    <p class="hero-lead">
      The current state of UI translations in
      {formatCount(plugins.length, "Starlight plugin", "Starlight plugins")}
      across {formatCount(languages.length, "language", "languages")}.
    </p>
  </header>

  <aside class="note" aria-labelledby="note-title">
    <h2 id="note-title">Tracking, not a to-do list</h2>
    <p>
      This site is not a call to translate every plugin into every language.
      Each language is something plugin maintainers have to keep up to date, so
      a plugin is only tracked in the languages it already ships. What shows up
      as missing are keys added after a translation was contributed.
    </p>
    <p>
      Want to help? Check the missing keys of your language and open a pull
      request on the plugin's repository.
    </p>
  </aside>

  <Section id="plugins" title="Plugins">
    <ul>
      {plugins.map((plugin) => (
        <OverviewCard
          description={`${formatCount(plugin.keys.length, "key", "keys")} · ${formatCount(plugin.locales.length, "language", "languages")}`}
          href={`/plugins/${plugin.config.packageName}/`}
          progress={getPluginProgress(plugin)}
          subtitle={plugin.config.packageName}
          title={plugin.config.name}
        />
      ))}
    </ul>
  </Section>

  <Section id="languages" title="Languages">
    <ul>
      {languages.map((language) => (
        <OverviewCard
          description={`${language.lang} · ${formatCount(language.plugins.length, "plugin", "plugins")}`}
          href={`/languages/${language.lang}/`}
          progress={getLanguageProgress(language)}
          subtitle={
            language.englishName === language.nativeName
              ? undefined
              : language.englishName
          }
          title={language.nativeName}
        />
      ))}
    </ul>
  </Section>
</BaseLayout>

<style>
  .hero {
    max-width: 48rem;
  }

  .hero-eyebrow {
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    margin-block-end: 0.75rem;
    text-transform: uppercase;
  }

  .hero-lead {
    color: var(--color-text-muted);
    font-size: 1.1875rem;
    margin-block-start: 1rem;
  }

  .note {
    background: var(--color-accent-soft);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: var(--radius);
    margin-block-start: 2.5rem;
    max-width: 48rem;
    padding: 1.25rem 1.5rem;
  }

  .note h2 {
    font-size: 1rem;
    margin-block-end: 0.5rem;
  }

  .note p {
    font-size: 0.9375rem;
  }

  .note p + p {
    margin-block-start: 0.5rem;
  }
</style>
