---
import type { GetStaticPaths } from "astro";

import { formatCount } from "../../libs/format";
import {
  type TrackedLanguage,
  getLanguageProgress,
  getTrackedLanguages,
  getTrackedPlugins,
} from "../../libs/tracker";

import LocaleStatus from "../../components/LocaleStatus.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const languages = getTrackedLanguages(await getTrackedPlugins());

  return languages.map((language) => ({
    params: { language: language.lang },
    props: { language },
  }));
}) satisfies GetStaticPaths;

interface Props {
  language: TrackedLanguage;
}

const { language } = Astro.props;
---

<BaseLayout
  title={language.englishName}
  description={`The current state of the ${language.englishName} UI translations of Starlight plugins.`}
>
  <PageHeader
    eyebrow="Language"
    lang={language.lang}
    progress={getLanguageProgress(language)}
    subtitle={
      language.englishName === language.nativeName
        ? language.lang
        : `${language.englishName} · ${language.lang}`
    }
    title={language.nativeName}
  />

  <Section id="by-plugin" title="By plugin">
    <p slot="description">
      {formatCount(language.plugins.length, "plugin is", "plugins are")}{" "}
      translated to {language.englishName}.
    </p>
    <ul class="stack">
      {language.plugins.map(({ locale, plugin }) => (
        <LocaleStatus
          keys={locale.keys}
          subtitle={plugin.config.packageName}
          title={plugin.config.name}
        />
      ))}
    </ul>
  </Section>
</BaseLayout>
